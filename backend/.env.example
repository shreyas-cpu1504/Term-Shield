APP_NAME=Contract Simplifier API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1
MAX_UPLOAD_SIZE_MB=25

# Secrets & Database
# GEMINI_API_KEY=
# DATABASE_URL=sqlite+aiosqlite:///storage/term_shield.db
# NEON_DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# JWT_SECRET_KEY=
# FRONTEND_URL=http://localhost:5173

# Email Delivery (Resend)
# RESEND_API_KEY=re_...
# EMAIL_FROM=Term Shield <onboarding@resend.dev>

# Google OAuth 2.0 / OpenID Connect
# Register redirect URI in Google Cloud Console:
# http://127.0.0.1:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback

# Persistent Object Storage (Cloudflare R2 or Supabase S3 for Render)
# Defaults to "local" filesystem. Set to "supabase" or "r2" for production.
# STORAGE_PROVIDER=local

# Supabase Storage (S3-compatible)
# SUPABASE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=
# SUPABASE_S3_BUCKET=term-shield-contracts

# Cloudflare R2 (Alternative S3-compatible)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=term-shield-contracts
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
